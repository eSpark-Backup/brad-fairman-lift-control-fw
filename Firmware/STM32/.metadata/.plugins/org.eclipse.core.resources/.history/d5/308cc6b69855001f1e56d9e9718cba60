void HAL_GPIO_EXTI_Rising_Callback(uint16_t GPIO_Pin) {
	switch(GPIO_Pin) {
	case TOUCH_SENSOR_Pin:			// Active high
		touch_flag = true;
		break;
	case IR_FEEDBACK_SENSOR_Pin:			// Active low
		ir_flag = false;
		break;
	default:
		break;
	}
}

void HAL_GPIO_EXTI_Falling_Callback(uint16_t GPIO_Pin) {
	switch(GPIO_Pin) {
	case TOUCH_SENSOR_Pin:			// Active high
		touch_flag = false;
		break;
	case IR_FEEDBACK_SENSOR_Pin:			// Active low
		ir_flag = true;
		break;
	default:
		break;
	}
}
