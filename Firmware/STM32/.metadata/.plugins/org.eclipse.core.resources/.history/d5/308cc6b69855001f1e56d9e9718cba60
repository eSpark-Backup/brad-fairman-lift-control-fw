#include <mainApp.hpp>
#include <DRV8873.hpp>


bool touch_flag;
bool ir_flag;

// MOTOR PINS
GPIO_Pins Motor1_CS = {
	.port = MOTOR1_CS_GPIO_Port,
	.pin = MOTOR1_CS_Pin							// SPI SS pin
};
GPIO_Pins Motor2_CS = {
	.port = MOTOR2_CS_GPIO_Port,
	.pin = MOTOR2_CS_Pin							// SPI SS pin
};
GPIO_Pins Motor_SLEEP = {
	.port = MOTOR_SLEEP_GPIO_Port,
	.pin = MOTOR_SLEEP_Pin
};
GPIO_Pins Motor_DISABLE = {
	.port = MOTOR_DISABLE_GPIO_Port,
	.pin = MOTOR_DISABLE_Pin
};



void mainApp::motor_control(motor_control_e state) {
	switch(state) {
	case MOTOR_OK:
		HAL_GPIO_WritePin(Motor_SLEEP.port, Motor_SLEEP.pin, GPIO_PIN_SET);
		break;
	case MOTOR_SLEEP:
		HAL_GPIO_WritePin(Motor_SLEEP.port, Motor_SLEEP.pin, GPIO_PIN_RESET);
		break;
	case MOTOR_ENABLE:
		HAL_GPIO_WritePin(Motor_DISABLE.port, Motor_DISABLE.pin, GPIO_PIN_RESET);
		break;
	case MOTOR_DISABLE:
		HAL_GPIO_WritePin(Motor_DISABLE.port, Motor_DISABLE.pin, GPIO_PIN_SET);
		break;
	default:
		break;
	}
}

mainApp::mainApp(SPI_HandleTypeDef* SPI_handle, I2C_HandleTypeDef* I2C1_handle, I2C_HandleTypeDef* I2C2_handle, TIM_HandleTypeDef* TIM_handle) {
	_SPI_handle_ = SPI_handle;
	_I2C_ADC_handle_ = I2C2_handle;
	_I2C_SENSOR_handle_ = I2C1_handle;
	_MOTOR_PWM_TIM_handle_ = TIM_handle;

	MOTOR1_drv = new DRV8873(_SPI_handle_, _MOTOR_PWM_TIM_handle_, Motor1_CS, TIM_CHANNEL_4, TIM_CHANNEL_3);
	MOTOR2_drv = new DRV8873(_SPI_handle_, _MOTOR_PWM_TIM_handle_, Motor2_CS, TIM_CHANNEL_2, TIM_CHANNEL_1);
}

void mainApp::initialize(void) {
	motor1_status = MOTOR1_drv->Init(DRV8873_INITIALIZE);
	motor2_status = MOTOR2_drv->Init(DRV8873_INITIALIZE);

	motor_control(MOTOR_OK);
	motor_control(MOTOR_ENABLE);

	if (HAL_TIM_Base_Start_IT(_MOTOR_PWM_TIM_handle_) != HAL_OK) {
	  // Timer start error
	  Error_Handler();
    }
}

